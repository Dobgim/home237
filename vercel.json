{
  "outputDirectory": "build/web",
  "buildCommand": "echo 'Using pre-built Flutter web output'",
  "installCommand": "echo 'No install needed'",
  "framework": null,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.home237.com" }],
      "destination": "https://home237.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://home237-92c18.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://home237-92c18.firebaseapp.com/__/firebase/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
