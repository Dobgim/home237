<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust system CAs for all connections (default) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Explicitly trust system CAs for Fapshi live endpoint -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">live.fapshi.com</domain>
        <domain includeSubdomains="true">fapshi.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
