rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // A self-write may only ever result in a NON-privileged role. This keeps
    // onboarding role-selection working (none → tenant/landlord) while making
    // it impossible for a user to promote themselves to 'admin'.
    function selfRoleAllowed() {
      return request.resource.data.role in ['none', 'tenant', 'landlord'];
    }

    // ── Users ────────────────────────────────────────────────────────────────
    // A user may edit their own document but may NOT change their own role
    // (prevents self-promotion to admin). Only an admin can change roles.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role in ['none', 'tenant', 'landlord'];
      allow update: if isAdmin() ||
                    (isSignedIn() && request.auth.uid == userId && selfRoleAllowed());
      allow delete: if isAdmin();
    }

    // ── Password reset codes ─────────────────────────────────────────────────
    // Never world-readable: a leaked code = account takeover. Handled by a
    // trusted server (Cloud Function / Edge Function) using the Admin SDK,
    // which bypasses these rules. Clients get no direct access.
    match /password_reset_codes/{email} {
      allow read, write: if false;
    }

    // ── Verification documents ───────────────────────────────────────────────
    match /verifications/{verificationId} {
      allow read, write: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── Properties ───────────────────────────────────────────────────────────
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        (request.resource.data.landlordId == request.auth.uid || isAdmin());
      // Owner/admin may edit freely. Anyone signed-in may only bump the
      // aggregate counters (view/like/rating), nothing else.
      allow update: if isSignedIn() && (
        resource.data.landlordId == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['views', 'likesCount', 'rating', 'ratingCount'])
      );
      allow delete: if isSignedIn() &&
        (resource.data.landlordId == request.auth.uid || isAdmin());

      match /ratings/{userId} {
        allow read: if true;
        allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ── Support Chats ────────────────────────────────────────────────────────
    match /support_chats/{chatId} {
      allow read, write: if isSignedIn() && (request.auth.uid == chatId || isAdmin());
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          (exists(/databases/$(database)/documents/support_chats/$(chatId)) &&
           get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid) ||
          isAdmin()
        );
      }
    }

    // ── Tour Requests ────────────────────────────────────────────────────────
    match /tour_requests/{requestId} {
      allow read, write: if isSignedIn() && (
        resource == null ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
    }

    // ── Notifications ────────────────────────────────────────────────────────
    // Only the owner or an admin may read. Writes are limited to the owner or
    // an admin — a signed-in user can no longer forge notifications to anyone.
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn() && (notificationId == request.auth.uid || isAdmin());
      match /items/{itemId} {
        allow read: if isSignedIn() && (notificationId == request.auth.uid || isAdmin());
        allow write: if isSignedIn() && (notificationId == request.auth.uid || isAdmin());
      }
    }

    // ── Reports ──────────────────────────────────────────────────────────────
    // A user may file a report and read their own; only admins read them all.
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() &&
        (resource.data.reporterId == request.auth.uid || isAdmin());
    }

    // ── Favorites ────────────────────────────────────────────────────────────
    match /favorites/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      match /properties/{propertyId} {
        allow read, write: if isSignedIn() && (userId == request.auth.uid || isAdmin());
      }
    }

    // ── Peer-to-peer Messages (Chat) ─────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
        (resource != null && request.auth.uid in resource.data.participants) ||
        isAdmin()
      );
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) ||
          isAdmin()
        );
      }
    }

    // ── Top-level messages (admin cascade delete) ────────────────────────────
    match /messages/{messageId} {
      allow read, write: if isSignedIn() && (
        resource == null ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    // ── Banned users ─────────────────────────────────────────────────────────
    match /banned_users/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── AI Chats (Virtual Assistant) ─────────────────────────────────────────
    // Scope guest sessions to their own session id; no blanket world access.
    match /ai_chats/{sessionId} {
      allow read, write: if
        (isSignedIn() && (resource == null ||
          resource.data.userId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid)) ||
        (resource == null && request.resource.data.userId.matches('^guest_.*')) ||
        (resource != null && resource.data.userId.matches('^guest_.*'));
      match /messages/{messageId} {
        allow read, write: if
          isSignedIn() ||
          (exists(/databases/$(database)/documents/ai_chats/$(sessionId)) &&
           get(/databases/$(database)/documents/ai_chats/$(sessionId)).data.userId.matches('^guest_.*'));
      }
    }

    // ── Admin Settings ───────────────────────────────────────────────────────
    // Payment credentials (e.g. 'fapshi') are NO LONGER world-readable. Only
    // the 'groq' doc stays public because the AI assistant is used by guests
    // and reads its key client-side. SECURITY DEBT: the Groq key should move
    // behind a server-side proxy (like the Fapshi Edge Function) so it isn't
    // exposed at all; until then, treat that key as public and rotate freely.
    match /admin_settings/{settingId} {
      allow read: if settingId == 'groq' || isSignedIn();
      allow write: if isAdmin();
    }

    // ── Sessions (device enforcement) ────────────────────────────────────────
    match /sessions/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ── Leases ───────────────────────────────────────────────────────────────
    match /leases/{leaseId} {
      allow read, write: if isSignedIn() && (
        resource == null ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isAdmin()
      );
    }

    // ── Rent transactions ────────────────────────────────────────────────────
    // Readable/writable by the paying tenant or admin (matches current client
    // flow). NOTE: status is still flipped to 'paid' client-side today, which
    // is forgeable — the real hardening is to move confirmation into the Fapshi
    // Edge Function and then tighten `update` to `isAdmin()` only.
    match /rent_transactions/{transId} {
      allow read, write: if isSignedIn() &&
        (resource == null ||
         resource.data.tenantId == request.auth.uid ||
         isAdmin());
    }

    // ── Platform earnings (commission ledger) ────────────────────────────────
    // Read is admin-only so the revenue ledger isn't exposed. Writes are left
    // open to signed-in users because the payout path currently records the
    // commission client-side; once payouts move into the Edge Function, tighten
    // `create` to `isAdmin()`.
    match /platform_earnings/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
